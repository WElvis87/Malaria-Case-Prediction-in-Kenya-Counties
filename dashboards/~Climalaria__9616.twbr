        <calculation class='tableau' formula='IF [Year] = [Parameters].[Parameter 1] - 1 THEN [Total Cases] ELSE 0 END' />
      </column>
      <column caption='%Year Difference' datatype='real' name='[Calculation_661184770423746572]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_661184770404614145])-SUM([Calculation_661184770423308299]))/SUM([Calculation_661184770423308299])' />
      </column>
      <column caption='Max Month' datatype='string' name='[Calculation_661184770447237133]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = 2022 THEN &quot;507.6K&quot; ELSEIF [Parameters].[Parameter 1] = 2023 THEN &quot;566.8K&quot; ELSEIF [Parameters].[Parameter 1] = 2024 THEN &quot;374.6K&quot; END' />
